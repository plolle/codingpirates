# Kun til at se sitet lokalt:  bundle install  og  bundle exec jekyll serve
# github-pages giver de samme versioner af Jekyll og plugins som GitHub bruger.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Windows mangler tidszonedata og en hurtig fil-overvaagning
gem "tzinfo-data", platforms: [:windows]
gem "wdm", ">= 0.1.0", platforms: [:windows]
